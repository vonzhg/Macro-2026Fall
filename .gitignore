# and tracked locally but held back until the course reaches them.  To release
# a session, delete its line below and put its rows back into slides/index.html.
# ---------------------------------------------------------------------------
slides/pdf/S03_*.pdf
slides/S03/
slides/pdf/S04_*.pdf
slides/S04/
slides/pdf/S05_*.pdf
slides/S05/
