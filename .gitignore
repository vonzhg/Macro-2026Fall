# LaTeX build artifacts
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
# compiled decks live in slides/pdf/ (watermarked); the unwatermarked copies next to the .tex are not published
slides/S[0-9][0-9]/*.pdf

# private: never published
supporting-intro/
plans/
plan-*.txt
course-build-plan-*.md

# assessments that must stay private
homeworks-exams/Midterm/
homeworks-exams/_archive/
**/*solution*
**/reference_code/

# build/run logs from tools/run_code.slurm
tools/logs/

# Python / notebooks
__pycache__/
.ipynb_checkpoints/
.DS_Store

# ---------------------------------------------------------------------------
# PUBLIC REPO — added 2026-09-17 when the site was first pushed.
# ---------------------------------------------------------------------------

# The three decks once held back as publish blockers (S01_A1, S02_A2, S02_B3)
# were cleared by the instructor on 2026-09-23 and are now posted. Their LaTeX
# sources and raw figure files stay unpublished, like every other session's
# sources until it is released.
slides/S01/
slides/S02/

# Instructor-facing working notes: absolute paths into private folders,
# unpublished numbers, and provenance for material that is not cleared.
CLAUDE.md
slides/SOURCES.md

# Old 2019 HUST problem sets, kept locally until archived
homeworks-exams/PS*.lyx

# LaTeX intermediates that the top-of-file rules miss
homeworks-exams/**/*.aux
homeworks-exams/**/*.log
homeworks-exams/**/*.out

# Combined deck PDFs from tools/combine_slides.py.  The default merge contains
# the three publish-blocker decks, so the invariant is: only files built with
# --public may be handed out, and only those are tracked.
slides/pdf/ECON282E_*.pdf
!slides/pdf/ECON282E_*_public.pdf

# ---------------------------------------------------------------------------
